<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_white"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="28dp">

    <!-- Cố định: Header "Today 26 Dec" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tv_header_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/text_black"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tv_header_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="26 Dec"
            android:textSize="26sp"
            android:textColor="@color/text_gray"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Cố định: 2x2 Category Cards Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <!-- Row 1: Health & Work -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Card 1: Health -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_health"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/cat_health_bg"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_cat_health"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_heart"
                        android:contentDescription="@string/cat_health" />

                    <TextView
                        android:id="@+id/tv_cat_health_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="6 Health"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_black" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Work -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_work"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/cat_work_bg"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_cat_work"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_work"
                        android:contentDescription="@string/cat_work" />

                    <TextView
                        android:id="@+id/tv_cat_work_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="5 Work"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_black" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 2: Mental Health & Others -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Card 3: Mental Health -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_mental"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/cat_mental_bg"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_cat_mental"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_mental_health"
                        android:contentDescription="@string/cat_mental" />

                    <TextView
                        android:id="@+id/tv_cat_mental_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="4 Mental Health"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_black" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 4: Others -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_others"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/cat_others_bg"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_cat_others"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_folder"
                        android:contentDescription="@string/cat_others" />

                    <TextView
                        android:id="@+id/tv_cat_others_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="13 Others"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_black" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Category filter indicator (cố định) -->
    <TextView
        android:id="@+id/tv_filter_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textSize="13sp"
        android:textColor="@color/text_gray"
        android:visibility="gone" />

    <!-- Cuộn: Danh sách công việc (chỉ cuộn phần này) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="90dp" />

</LinearLayout>
